{
    "StartGame": {
        "recognition": "TemplateMatch",
        "template": "ptn_logo",
        "threshold": 0.6,
        "action": "Click",
        "next": ["LoadingWait", "ClosePopup", "DailyRewardEntry"]
    },
    "LoadingWait": {
        "recognition": "TemplateMatch",
        "template": "loading_indicator",
        "threshold": 0.5,
        "action": "DoNothing",
        "timeout": 60000,
        "next": ["ClosePopup", "DailyRewardEntry"]
    },
    "ClosePopup": {
        "recognition": "TemplateMatch",
        "template": ["btn_close", "btn_confirm", "popup_close"],
        "threshold": 0.6,
        "action": "Click",
        "next": ["ClosePopup", "DailyRewardEntry"]
    },
    "DailyRewardEntry": {
        "recognition": "TemplateMatch",
        "template": "btn_daily_reward",
        "threshold": 0.6,
        "action": "Click",
        "pre_delay": 1000,
        "next": ["DailyRewardClaim", "DailyRewardAlreadyClaimed"]
    },
    "DailyRewardClaim": {
        "recognition": "TemplateMatch",
        "template": "btn_claim_reward",
        "threshold": 0.6,
        "action": "Click",
        "post_delay": 1000,
        "next": ["DailyRewardClaimConfirm", "DailyRewardDone"]
    },
    "DailyRewardClaimConfirm": {
        "recognition": "TemplateMatch",
        "template": "btn_confirm",
        "threshold": 0.6,
        "action": "Click",
        "post_delay": 500,
        "next": ["DailyRewardDone"]
    },
    "DailyRewardAlreadyClaimed": {
        "recognition": "TemplateMatch",
        "template": "text_already_claimed",
        "threshold": 0.5,
        "action": "DoNothing",
        "next": ["DailyRewardDone"]
    },
    "DailyRewardDone": {
        "recognition": "DirectHit",
        "action": "Click",
        "target": [30, 30, 1, 1],
        "next": ["MailEntry"]
    },
    "MailEntry": {
        "recognition": "TemplateMatch",
        "template": "btn_mail",
        "threshold": 0.6,
        "action": "Click",
        "pre_delay": 1000,
        "next": ["MailClaimAll", "MailEmpty"]
    },
    "MailClaimAll": {
        "recognition": "TemplateMatch",
        "template": "btn_claim_all",
        "threshold": 0.6,
        "action": "Click",
        "post_delay": 1000,
        "next": ["MailClaimConfirm", "MailDone"]
    },
    "MailClaimConfirm": {
        "recognition": "TemplateMatch",
        "template": "btn_confirm",
        "threshold": 0.6,
        "action": "Click",
        "post_delay": 500,
        "next": ["MailDone"]
    },
    "MailEmpty": {
        "recognition": "TemplateMatch",
        "template": "text_no_mail",
        "threshold": 0.5,
        "action": "DoNothing",
        "next": ["MailDone"]
    },
    "MailDone": {
        "recognition": "DirectHit",
        "action": "Click",
        "target": [30, 30, 1, 1],
        "next": ["DispatchEntry"]
    },
    "DispatchEntry": {
        "recognition": "TemplateMatch",
        "template": "btn_dispatch",
        "threshold": 0.6,
        "action": "Click",
        "pre_delay": 1500,
        "next": ["DispatchClaim", "DispatchStart", "DispatchInProgress"]
    },
    "DispatchClaim": {
        "recognition": "TemplateMatch",
        "template": "btn_dispatch_claim",
        "threshold": 0.6,
        "action": "Click",
        "post_delay": 1000,
        "next": ["DispatchClaimConfirm", "DispatchStart"]
    },
    "DispatchClaimConfirm": {
        "recognition": "TemplateMatch",
        "template": "btn_confirm",
        "threshold": 0.6,
        "action": "Click",
        "post_delay": 500,
        "next": ["DispatchStart"]
    },
    "DispatchStart": {
        "recognition": "TemplateMatch",
        "template": "btn_dispatch_start",
        "threshold": 0.6,
        "action": "Click",
        "post_delay": 500,
        "next": ["DispatchSelectAll", "DispatchConfirm"]
    },
    "DispatchSelectAll": {
        "recognition": "TemplateMatch",
        "template": "btn_select_all",
        "threshold": 0.6,
        "action": "Click",
        "post_delay": 300,
        "next": ["DispatchConfirm"]
    },
    "DispatchConfirm": {
        "recognition": "TemplateMatch",
        "template": "btn_dispatch_confirm",
        "threshold": 0.6,
        "action": "Click",
        "post_delay": 1000,
        "next": ["DispatchDone"]
    },
    "DispatchInProgress": {
        "recognition": "TemplateMatch",
        "template": "text_dispatch_in_progress",
        "threshold": 0.5,
        "action": "DoNothing",
        "next": ["DispatchDone"]
    },
    "DispatchDone": {
        "recognition": "DirectHit",
        "action": "Click",
        "target": [30, 30, 1, 1],
        "next": ["FriendEntry"]
    },
    "FriendEntry": {
        "recognition": "TemplateMatch",
        "template": "btn_friend",
        "threshold": 0.6,
        "action": "Click",
        "pre_delay": 1500,
        "next": ["FriendVisit", "FriendDone"]
    },
    "FriendVisit": {
        "recognition": "TemplateMatch",
        "template": "btn_visit",
        "threshold": 0.6,
        "action": "Click",
        "post_delay": 1000,
        "next": ["FriendVisitNext", "FriendDone"]
    },
    "FriendVisitNext": {
        "recognition": "TemplateMatch",
        "template": "btn_next_friend",
        "threshold": 0.6,
        "action": "Click",
        "post_delay": 500,
        "repeat": 5,
        "repeat_delay": 800,
        "next": ["FriendDone"]
    },
    "FriendDone": {
        "recognition": "DirectHit",
        "action": "Click",
        "target": [30, 30, 1, 1],
        "next": ["BackToHome"]
    },
    "BackToHome": {
        "recognition": "TemplateMatch",
        "template": "btn_home",
        "threshold": 0.6,
        "action": "Click",
        "post_delay": 1000,
        "next": ["HomeReady"]
    },
    "HomeReady": {
        "recognition": "TemplateMatch",
        "template": "home_indicator",
        "threshold": 0.5,
        "action": "DoNothing",
        "next": []
    }
}
