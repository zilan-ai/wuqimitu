{
    "Login_EnterGame": {
        "recognition": "TemplateMatch",
        "template": "login/enter_game",
        "threshold": 0.6,
        "action": "Click",
        "post_delay": 3000,
        "next": ["Login_LoadingWait", "EmotionCheck_Entry"]
    },
    "Login_LoadingWait": {
        "recognition": "TemplateMatch",
        "template": "common/loading",
        "threshold": 0.5,
        "action": "DoNothing",
        "timeout": 60000,
        "next": ["EmotionCheck_Entry", "LoginPush_CheckNoMore"]
    },
    "EmotionCheck_Entry": {
        "recognition": "TemplateMatch",
        "template": "emotion_check/option_button",
        "threshold": 0.6,
        "action": "Click",
        "post_delay": 1500,
        "next": ["EmotionCheck_Confirm", "EmotionCheck_Done"]
    },
    "EmotionCheck_Confirm": {
        "recognition": "TemplateMatch",
        "template": "common/btn_confirm",
        "threshold": 0.6,
        "action": "Click",
        "post_delay": 1000,
        "next": ["EmotionCheck_Done"]
    },
    "EmotionCheck_Done": {
        "recognition": "DirectHit",
        "action": "Click",
        "target": [1270, 10, 1, 1],
        "post_delay": 1000,
        "next": ["LoginPush_CheckNoMore"]
    },
    "LoginPush_CheckNoMore": {
        "recognition": "TemplateMatch",
        "template": "login_push/check_no_more",
        "threshold": 0.6,
        "action": "Click",
        "post_delay": 500,
        "next": ["LoginPush_Close"]
    },
    "LoginPush_Close": {
        "recognition": "TemplateMatch",
